set -euo pipefail

# Resolve o diretorio raiz do cctl (onde este script esta)
CCTL_ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
export CCTL_ROOT

# cctl nao suporta execucao global — deve ser invocado como ./cctl
# dentro do seu proprio diretorio de instalacao
if [[ "$(pwd)" != "${CCTL_ROOT}" ]]; then
    echo "ERRO: cctl deve ser executado de dentro do seu diretorio de instalacao." >&2
    echo "  Diretorio atual:   $(pwd)" >&2
    echo "  Diretorio do cctl: ${CCTL_ROOT}" >&2
    echo "" >&2
    echo "  Execute: cd ${CCTL_ROOT} && ./cctl <comando>" >&2
    exit 1
fi

# Bootstrap: carrega libs
source "${CCTL_ROOT}/lib/core.sh"
core_bootstrap

# Parse argumentos globais
CCTL_COMMAND=""
CCTL_ARGS=()
CCTL_VERBOSE="${CCTL_VERBOSE:-false}"
core_parse_global_args "$@"

# Detecta contexto
core_detect_context

# Dica de autocomplete (somente no contexto local, nao no servidor)
if [[ "${CCTL_CONTEXT:-}" == "template" ]] && [[ -z "${CCTL_COMPLETION_LOADED:-}" ]]; then
    echo "[DICA] Autocomplete nao ativo. Para ativar, adicione ao ~/.bashrc:" >&2
    echo "  source ${CCTL_ROOT}/cctl-completion.bash" >&2
    echo "" >&2
fi

# Verifica se o comando e valido para o contexto
core_check_command_context "${CCTL_COMMAND}" || exit 1

# Carrega manifest se disponivel
core_load_manifest

# Carrega .env se disponivel
if [[ "${CCTL_CONTEXT}" == "instance" || "${CCTL_CONTEXT}" == "client_branch" ]]; then
    env_load
fi

# Dispatch
core_dispatch "${CCTL_COMMAND}" "${CCTL_ARGS[@]}"
