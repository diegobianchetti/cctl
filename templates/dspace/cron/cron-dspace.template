# cron-dspace — Cron jobs para DSpace (ambiente dev/teste)
# Instalado em /etc/cron.d/cron-{{COMPOSE_PROJECT_NAME}}

# Geracao de thumbnails (a cada hora)
0 * * * * root /usr/bin/docker exec {{COMPOSE_PROJECT_NAME}}-dspace bash -c "/dspace/bin/dspace filter-media" > /dev/null 2>&1

# Importacao OAI (a cada 2 horas)
0 */2 * * * root /usr/bin/docker exec {{COMPOSE_PROJECT_NAME}}-dspace bash -c "/dspace/bin/dspace oai import" > /dev/null 2>&1
