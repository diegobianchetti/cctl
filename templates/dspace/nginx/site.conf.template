server {
	listen 80;
	listen [::]:80;
	server_name {{DOMAIN_NAME}};

	if ($block_uri_pattern) { return 444; }
	if ($block_ip)          { return 444; }

	include /etc/nginx/conf.d/error-pages.conf;

	resolver 127.0.0.11;

	location /server {
		set $target dspace:8080;
		proxy_pass http://$target;

		proxy_set_header        Host                    $http_host;
		proxy_set_header        X-Real-IP               $remote_addr;
		proxy_set_header        X-Forwarded-Host        $host;
		proxy_set_header        X-Forwarded-Server      $host;
		proxy_set_header        X-Forwarded-For         $proxy_add_x_forwarded_for;
		proxy_set_header        X-Forwarded-Proto       http;

		proxy_cookie_path       / "/; HttpOnly; SameSite=Lax";

		client_max_body_size    150M;
		proxy_read_timeout      60m;
		proxy_connect_timeout   60m;
		proxy_send_timeout      60m;
	}

	location / {
		set $target dspace-angular:4000;
		proxy_pass http://$target;

		proxy_set_header        Host                    $http_host;
		proxy_set_header        X-Real-IP               $remote_addr;
		proxy_set_header        X-Forwarded-Host        $host;
		proxy_set_header        X-Forwarded-Server      $host;
		proxy_set_header        X-Forwarded-For         $proxy_add_x_forwarded_for;
		proxy_set_header        X-Forwarded-Proto       http;

		proxy_cookie_path       / "/; HttpOnly; SameSite=Lax";

		client_max_body_size    150M;
		proxy_read_timeout      60m;
		proxy_connect_timeout   60m;
		proxy_send_timeout      60m;
	}

	access_log  /var/log/nginx/{{COMPOSE_PROJECT_NAME}}-access-dspace.log;
	error_log   /var/log/nginx/{{COMPOSE_PROJECT_NAME}}-error-dspace.log;
}
